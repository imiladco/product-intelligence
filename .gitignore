# Secrets — never commit
.env
.env.*
!.env.example
!.env.staging.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local data
/postgres-data/

# collectstatic output. Generated, never authored: the container writes it to
# DJANGO_STATIC_ROOT, and running the API locally writes it here.
/apps/api/staticfiles/

# Google OAuth client downloads. Narrow on purpose: only Google's own
# client_secret*.json naming, so unrelated JSON stays tracked.
client_secret*.json
*.apps.googleusercontent.com.json
