# Staging environment template — PLACEHOLDERS ONLY, never real values.
#
# On the server: copy to `.env` in the deployment directory, fill it in, then
#   chmod 600 .env
# It is read by compose (env_file) and must never be committed.

# --- Public identity --------------------------------------------------------
APP_DOMAIN=staging.arkav.lol
APP_URL=https://staging.arkav.lol
# Required: Let's Encrypt uses it for expiry notices.
ACME_EMAIL=

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=false
# Generate a value unique to staging — do not reuse the local development key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Must list every Host header Django will actually see, not just the public
# one. Caddy forwards the public host, but two internal callers do not:
#   - Next.js server-side rendering calls http://api:8000  -> Host: api:8000
#   - the container healthcheck calls 127.0.0.1:8000       -> Host: 127.0.0.1
# Omitting these returns HTTP 400 DisallowedHost, the API never reports
# healthy, and the stack never finishes starting. These names resolve only on
# the private Docker network, so listing them exposes nothing publicly.
DJANGO_ALLOWED_HOSTS=staging.arkav.lol,api,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://staging.arkav.lol
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Staging-only database. The host is the compose service name; the port is
# never published to the internet.
POSTGRES_DB=product_intelligence_staging
POSTGRES_USER=product_intelligence
POSTGRES_PASSWORD=
DATABASE_URL=postgres://product_intelligence:CHANGEME@postgres:5432/product_intelligence_staging

# --- Credential encryption --------------------------------------------------
# A NEW key for staging, not the local development one. Losing it makes every
# stored OAuth credential unrecoverable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=

# --- Google OAuth -----------------------------------------------------------
# The development Web client. GOOGLE_OAUTH_REDIRECT_URI must match an
# Authorized redirect URI on that client EXACTLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://staging.arkav.lol/api/integrations/oauth/google/callback
OAUTH_STATE_TTL_SECONDS=600
