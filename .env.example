# Copy to .env and fill in. NEVER commit a real .env.
# Values here are placeholders only — no real secret belongs in this file.

# --- Application ------------------------------------------------------------
# The public origin of the app. Everything origin-related derives from this;
# the domain is never hard-coded in code or config.
APP_URL=http://localhost:3000

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required whenever DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
POSTGRES_DB=product_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/product_intelligence

# --- Frontend ---------------------------------------------------------------
# Browser-visible; must never hold a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side fetches from Next.js to Django. In development the Django dev
# server; in production the API container on the compose network.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# --- Later milestones -------------------------------------------------------
# Google OAuth client, credential encryption keys, and the production domain
# and ACME settings are introduced in Milestone 3 and Milestone 7. They are not
# read by the Milestone 1 code and are intentionally absent here.
