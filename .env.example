# Copy to .env and fill in. NEVER commit a real .env.
# Values here are placeholders only — no real secret belongs in this file.

# --- Application ------------------------------------------------------------
# The public origin of the app. Everything origin-related derives from this;
# the domain is never hard-coded in code or config.
APP_URL=http://localhost:3000

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required whenever DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
POSTGRES_DB=product_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/product_intelligence

# --- Frontend ---------------------------------------------------------------
# Browser-visible; must never hold a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side fetches from Next.js to Django. In development the Django dev
# server; in production the API container on the compose network.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# --- Credential encryption --------------------------------------------------
# Comma-separated urlsafe-base64 Fernet keys, NEWEST FIRST. The first key
# encrypts; every listed key can decrypt, which is what allows rotation.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Separate from DJANGO_SECRET_KEY. BACK THIS UP: without it, every stored
# OAuth credential is unrecoverable.
CREDENTIAL_ENCRYPTION_KEYS=

# --- Google OAuth -----------------------------------------------------------
# From a Google Cloud OAuth 2.0 Client ID of type "Web application".
# Use a DEVELOPMENT client locally; production credentials arrive in Milestone 7.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on that client EXACTLY.
# Local development: http://localhost:3000/api/integrations/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/oauth/google/callback
# How long an in-flight authorization stays valid, in seconds.
OAUTH_STATE_TTL_SECONDS=600

# --- Later milestones -------------------------------------------------------
# The production domain and ACME settings are introduced in Milestone 7.
