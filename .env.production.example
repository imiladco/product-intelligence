# Production environment template — PLACEHOLDERS ONLY, never real values.
#
# On the server: copy to /opt/product-intelligence/production/.env, fill it in
# with the non-echoing heredoc pattern in docs/DEPLOY.md §4, then
#   chown root:root .env && chmod 600 .env
# It is read by compose (env_file) and must never be committed.
#
# Every value that must be generated is left EMPTY here with the command that
# generates it. A populated secret in this file would be a committed secret.

# --- Public identity --------------------------------------------------------
APP_DOMAIN=app.arkav.lol
APP_URL=https://app.arkav.lol
# Required: Let's Encrypt uses it for expiry notices.
ACME_EMAIL=

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=false
# A value unique to production. Never the staging or development key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Every Host header Django will actually see, not just the public one. Caddy
# forwards the public host; two internal callers do not:
#   - Next.js server-side rendering calls http://api:8000  -> Host: api:8000
#   - the container healthcheck calls 127.0.0.1:8000       -> Host: 127.0.0.1
# Omitting these returns HTTP 400 DisallowedHost, the API never reports
# healthy, and the deploy fails its health gate. These names resolve only on
# the private Docker network, so listing them exposes nothing publicly.
DJANGO_ALLOWED_HOSTS=app.arkav.lol,api,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.arkav.lol
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Production-only database, on the production Compose project's own volume.
# The host is the compose service name; the port is never published.
POSTGRES_DB=product_intelligence_production
POSTGRES_USER=product_intelligence
POSTGRES_PASSWORD=
# Must contain the same password as POSTGRES_PASSWORD above.
DATABASE_URL=

# --- Credential encryption --------------------------------------------------
# A NEW key for production. Losing it makes every stored OAuth credential
# unrecoverable, and there is no database backup in M7 (docs/DEPLOY.md §8):
# back this key up off-server before the first deploy.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=

# --- Google OAuth -----------------------------------------------------------
# The production Web client. GOOGLE_OAUTH_REDIRECT_URI must match an
# Authorized redirect URI on that client EXACTLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.arkav.lol/api/integrations/oauth/google/callback
OAUTH_STATE_TTL_SECONDS=600

# --- Runtime sizing ---------------------------------------------------------
# One worker. The image defaults to 3, which suits a host that is not also
# running staging, n8n, cloudflared, Portainer and x-ui on one shared core.
GUNICORN_WORKERS=1
