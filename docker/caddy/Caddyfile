# Shared reverse proxy: staging and production, one Caddy, two site blocks.
#
# Caddy obtains and renews both certificates itself over HTTP-01, so port 80
# must reach this container and each hostname's DNS must already point here.
# It also redirects HTTP to HTTPS and sets X-Forwarded-Proto, which Django
# requires: with DEBUG=false it only sets secure cookies when it can see the
# request arrived over HTTPS.
#
# There is deliberately no `log` directive. Caddy's access log records the full
# URI including the query string, and the Google OAuth callback receives
# ?code=...&state=... there. M3 removed exactly that leak from gunicorn's
# access log; adding it back at the proxy would undo the fix one layer up.
#
# Each site proxies its OWN upstream aliases. This container is attached to both
# environments' edge networks, so a bare `api` would resolve to whichever
# environment answered first — which is how a production request gets served by
# staging. The aliases (staging-api, production-api) exist for this reason and
# each resolves on one edge network only.
#
# NOTE: this file serves app.arkav.lol and must only be installed once that
# hostname resolves to this host. Before then, install
# deploy/caddy/Caddyfile.staging-only, or Caddy will retry ACME against a
# hostname with no DNS record.

{
	email {$ACME_EMAIL}
}

staging.arkav.lol {
	encode zstd gzip

	# Django admin and DRF assets, written by the release step into this
	# environment's own static volume. Mounted at its own path, so the two
	# environments' assets cannot be served from one root.
	handle_path /static/* {
		root * /srv/static/staging
		file_server
	}

	handle /api/* {
		reverse_proxy staging-api:8000
	}

	handle /admin/* {
		reverse_proxy staging-api:8000
	}

	handle {
		reverse_proxy staging-web:3000
	}
}

app.arkav.lol {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static/production
		file_server
	}

	handle /api/* {
		reverse_proxy production-api:8000
	}

	handle /admin/* {
		reverse_proxy production-api:8000
	}

	handle {
		reverse_proxy production-web:3000
	}
}
